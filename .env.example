# Create your .env with: python astra.py init
# __generate__ becomes a random secret. Existing .env values are never overwritten.
# Never commit .env.

# --- LLM providers (given to the worker process only) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_FAST_MODEL=claude-haiku-5-5
LLM_STANDARD_MODEL=claude-haiku-5-5
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# on: also ask Groq's prompt guard about each document. Uses Groq's limited daily requests.
GUARD_REMOTE=off
LLM_TENANT_DAILY_TOKENS=2000000

# --- PostgreSQL ---
POSTGRES_PASSWORD=__generate__
ASTRA_OWNER_PASSWORD=__generate__
ASTRA_API_PASSWORD=__generate__
ASTRA_WORKER_PASSWORD=__generate__
ASTRA_EXECUTOR_PASSWORD=__generate__

# --- Neo4j ---
NEO4J_PASSWORD=__generate__

# --- MinIO ---
MINIO_ROOT_USER=astra-admin
MINIO_ROOT_PASSWORD=__generate__

# --- Application ---
# Password for every demo user created by `python astra.py seed`.
DEMO_PASSWORD=__generate__
SESSION_SECRET=__generate__
ASTRA_ENV=dev
