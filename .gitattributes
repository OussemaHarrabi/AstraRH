# Keep LF in the repo and working trees: these files run inside Linux containers.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files must never be converted.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.docx binary
*.zip binary
